# Local development: npm run dev
# Uses the restricted role, the same one production uses.
DATABASE_URL=postgres://ops_dashboard:PASSWORD@localhost:5432/ops
# Optional: links execution ids on /costs to n8n.
N8N_PUBLIC_URL=https://your-n8n-host
# Optional: the status strip reads the watchdog with its read-only key.
WATCHDOG_URL=https://ops-watchdog.<you>.workers.dev
WATCHDOG_STATUS_KEY=
