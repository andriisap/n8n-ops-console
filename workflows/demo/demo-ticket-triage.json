    {
      "id": "629582b8-e452-55c1-a499-03ed73312f75",
      "name": "Classify ticket",
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.9,
      "position": [
        440,
        0
      ],
      "parameters": {
        "promptType": "define",
        "text": "={{ $json.ticket }}",
        "messages": {
          "messageValues": [
            {
              "message": "You triage customer support tickets. Answer with JSON only, no prose, no code fences: {\"category\": \"billing|bug|access|feature_request|other\", \"urgency\": \"low|normal|high\", \"summary\": \"<one sentence>\"}"
            }
          ]
        }
      }
    },
    {
      "id": "1872e50c-a10d-5d0f-aab4-29a7f8450dcf",
      "name": "Groq Chat Model",
      "type": "@n8n/n8n-nodes-langchain.lmChatGroq",
      "typeVersion": 1,
      "position": [
        440,
        220
      ],
      "parameters": {
        "model": "openai/gpt-oss-20b",
        "options": {}
      }
    },
    {
      "id": "e52501be-5c6d-5820-a5c8-eb75e8556c59",
      "name": "Parse classification",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        760,
        0
      ],
      "parameters": {
        "jsCode": "// The classifier is asked for JSON, but a model can still wrap it in prose or fences.\nconst raw = String($json.text ?? '');\nconst match = raw.match(/\\{[\\s\\S]*\\}/);\nlet c = {};\ntry { c = match ? JSON.parse(match[0]) : {}; } catch (e) { c = {}; }\nreturn [{ json: {\n  ticket: $('Ticket').first().json.ticket,\n  category: c.category ?? 'other',\n  urgency: c.urgency ?? 'normal',\n  summary: c.summary ?? raw.slice(0, 200),\n} }];\n"
      }
    },
    {
      "id": "30f1d996-dfa0-539a-98ac-471d0ab0a1eb",
      "name": "Draft reply",
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.9,
      "position": [
        980,
        0
      ],
      "parameters": {
        "promptType": "define",
        "text": "=Ticket ({{ $json.category }}, urgency {{ $json.urgency }}):\n\n{{ $json.ticket }}",
        "messages": {
          "messageValues": [
            {
              "message": "You are a support agent. Write a short, friendly first reply to the customer (at most 5 sentences). Acknowledge the problem, say what happens next, and do not promise anything you can't know. Plain text, no greeting line with a name."
            }
          ]
        }
      }
    },
    {
      "id": "f042f60f-12ea-5399-98f5-eb8b45bf7aa8",
      "name": "Anthropic Chat Model",
      "type": "@n8n/n8n-nodes-langchain.lmChatAnthropic",
      "typeVersion": 1.6,
      "position": [
        980,
        220
      ],
      "parameters": {
        "model": {
          "__rl": true,
          "mode": "id",
          "value": "claude-haiku-5-5"
        },
        "options": {
          "maxTokensToSample": 400
        }
      }
    },
    {
