# Generate with: openssl rand -hex 24
# Hex only: a `$` in the password would be read by docker compose as a variable.
OPS_DB_PASSWORD=

# Password of the restricted ops_dashboard role (002_dashboard_role.sql). Same rule: hex only.
OPS_DASHBOARD_DB_PASSWORD=

# Login for ops.<host>: output of `htpasswd -nbB <user> '<password>'` with every $ doubled.
OPS_DASHBOARD_BASIC_AUTH=
